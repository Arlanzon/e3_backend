# Cadena de conexión PostgreSQL/Neon utilizada por Prisma y el cliente de ejecución de Prisma.
# Reemplaza los marcadores de posición con los valores propios de tu proyecto Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secreto utilizado para firmar y verificar tokens de acceso JWT.
# Usa un valor largo y aleatorio en entornos reales.
JWT_SECRET="replace-with-a-long-random-secret"

# Expiración opcional de JWT. Por defecto es 30m cuando se omite.
JWT_EXPIRES_IN="30m"
# Modo de ejecución. Next.js lo establece automáticamente para dev/build/start.
# Normalmente no es necesario establecerlo manualmente.
# NODE_ENV="development"
