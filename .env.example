# PostgreSQL / Neon connection string used by Prisma and the runtime Prisma client.
# Replace the placeholders with your own Neon project values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to sign and verify JWT access tokens.
# Use a long, random value in real environments.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional JWT expiration. Defaults to 30m when omitted.
JWT_EXPIRES_IN="30m"

# Runtime mode. Next.js sets this automatically for dev/build/start.
# Usually you do not need to set it manually.
# NODE_ENV="development"
